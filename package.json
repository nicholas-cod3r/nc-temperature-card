{
  "name": "nc-temperature-card",
  "version": "0.9.9",
  "description": "Home Assistant Lovelace temperature card",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "dev": "npx tsc --noEmit && node scripts/dev.js",
    "start": "npm run --silent dev",
    "deploy": "node scripts/deploy.js",
    "watch": "node scripts/deploy.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
